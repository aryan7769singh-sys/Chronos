generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// ---------------------------------------------------------------------------
// Enums
// PostgreSQL enum labels are stored as-is. Prisma identifiers use underscore
// because TypeScript identifiers cannot contain hyphens. The service layer
// maps "in_progress" → "in-progress", "on_track" → "on-track", etc.
// ---------------------------------------------------------------------------

enum Priority {
  urgent
  high
  medium
  low
}

enum ProjectStatus {
  active
  paused
  completed
  archived
  cancelled
}

enum ProjectHealth {
  on_track
  at_risk
  off_track
}

enum TaskStatus {
  backlog
  todo
  in_progress
  blocked
  in_review
  done
  cancelled
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// A top-level container for a body of related work.
/// The userId column is intentionally absent until the authentication milestone
/// adds the User model and the corresponding foreign key via a migration.
model Project {
  id          String        @id @default(cuid())
  name        String
  description String        @default("")
  /// One of the ProjectColor union values ("violet" | "blue" | ...)
  color       String        @default("violet")
  /// Lucide icon name string resolved at runtime via PROJECT_ICON_MAP
  icon        String        @default("Layers")
  status      ProjectStatus @default(active)
  priority    Priority      @default(medium)
  deadline    DateTime
  health      ProjectHealth @default(on_track)
  tasks       Task[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  /// Soft-delete timestamp. NULL means the record is active.
  deletedAt   DateTime?
}

/// A discrete unit of work within a Project.
model Task {
  id                String     @id @default(cuid())
  projectId         String
  project           Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title             String
  description       String     @default("")
  status            TaskStatus @default(backlog)
  priority          Priority   @default(medium)
  /// Estimated time to complete, in minutes.
  estimatedDuration Int        @default(0)
  /// Actual time spent, in minutes.
  actualDuration    Int        @default(0)
  deadline          DateTime
  /// The immediate next action required to advance this task.
  currentStep       String     @default("")
  /// Free-form string tags stored as a PostgreSQL text array.
  tags              String[]
  notes             String     @default("")
  subtasks          Subtask[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  /// Soft-delete timestamp. NULL means the record is active.
  deletedAt         DateTime?
}

/// An atomic step within a Task.
model Subtask {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Soft-delete timestamp. NULL means the record is active.
  deletedAt DateTime?
}
