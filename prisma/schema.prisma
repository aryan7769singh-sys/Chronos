generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// PostgreSQL enum labels are stored as-is. Prisma identifiers use underscore
// because TypeScript identifiers cannot contain hyphens. The service layer
// maps "in_progress" → "in-progress", "on_track" → "on-track", etc.
// ---------------------------------------------------------------------------

enum Priority {
  urgent
  high
  medium
  low
}

enum ProjectStatus {
  active
  paused
  completed
  archived
  cancelled
}

enum ProjectHealth {
  on_track
  at_risk
  off_track
}

enum TaskStatus {
  backlog
  todo
  in_progress
  blocked
  in_review
  done
  cancelled
}

enum CalendarEventType {
  event
  focus_block
  meeting
  reminder
}

// ---------------------------------------------------------------------------
// Auth.js Models
// ---------------------------------------------------------------------------

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String?         @unique
  emailVerified  DateTime?
  image          String?
  accounts       Account[]
  sessions       Session[]
  projects       Project[]
  calendarEvents CalendarEvent[]
  habits         Habit[]
  focusSessions  FocusSession[]
  notes          Note[]
  timeBlocks     TimeBlock[]
  settings       UserSettings?
  notifications  Notification[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain Models
// ---------------------------------------------------------------------------

/// A top-level container for a body of related work.
/// Every project is strictly owned by a User.
model Project {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  description    String          @default("")
  /// One of the ProjectColor union values ("violet" | "blue" | ...)
  color          String          @default("violet")
  /// Lucide icon name string resolved at runtime via PROJECT_ICON_MAP
  icon           String          @default("Layers")
  status         ProjectStatus   @default(active)
  priority       Priority        @default(medium)
  deadline       DateTime
  health         ProjectHealth   @default(on_track)
  tasks          Task[]
  calendarEvents CalendarEvent[]
  focusSessions  FocusSession[]
  notes          Note[]
  timeBlocks     TimeBlock[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  /// Soft-delete timestamp. NULL means the record is active.
  deletedAt      DateTime?

  @@index([userId])
}

/// A discrete unit of work within a Project.
model Task {
  id                String          @id @default(cuid())
  projectId         String
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title             String
  description       String          @default("")
  status            TaskStatus      @default(backlog)
  priority          Priority        @default(medium)
  /// Estimated time to complete, in minutes.
  estimatedDuration Int             @default(0)
  /// Actual time spent, in minutes.
  actualDuration    Int             @default(0)
  deadline          DateTime
  /// The immediate next action required to advance this task.
  currentStep       String          @default("")
  /// Free-form string tags stored as a PostgreSQL text array.
  tags              String[]
  notes             String          @default("")
  subtasks          Subtask[]
  calendarEvents    CalendarEvent[]
  focusSessions     FocusSession[]
  attachedNotes     Note[]
  timeBlocks        TimeBlock[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  /// Soft-delete timestamp. NULL means the record is active.
  deletedAt         DateTime?

  @@index([projectId])
  @@index([deadline])
}

/// An atomic step within a Task.
model Subtask {
  id        String    @id @default(cuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  completed Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft-delete timestamp. NULL means the record is active.
  deletedAt DateTime?

  @@index([taskId])
}

/// A scheduled time block, meeting, focus session, or event.
/// Strictly owned by a User; optionally linked to a Project and Task.
model CalendarEvent {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId      String?
  task        Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  title       String
  description String            @default("")
  type        CalendarEventType @default(event)
  allDay      Boolean           @default(false)
  startDate   DateTime
  endDate     DateTime
  color       String            @default("violet")
  location    String            @default("")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  /// Soft-delete timestamp. NULL means the record is active.
  deletedAt   DateTime?

  @@index([userId, startDate, endDate])
  @@index([projectId])
  @@index([taskId])
}

// ---------------------------------------------------------------------------
// Habits Domain Models
// ---------------------------------------------------------------------------

/// A recurring activity tracked over time for personal productivity.
/// Strictly owned by a User.
model Habit {
  id                String     @id @default(cuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  description       String     @default("")
  category          String     @default("General")
  /// One of the ProjectColor union values ("violet" | "blue" | "emerald" | ...)
  color             String     @default("violet")
  /// Lucide icon name string resolved at runtime via HABIT_ICON_MAP
  icon              String     @default("Repeat2")
  /// "daily" | "weekly"
  frequency         String     @default("daily")
  /// Target completions per week (1-7)
  targetDaysPerWeek Int        @default(7)
  archived          Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  /// Soft-delete timestamp. NULL means the record is active.
  deletedAt         DateTime?
  logs              HabitLog[]

  @@index([userId])
}

/// A single daily completion entry/log for a Habit.
model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  /// Normalized ISO day string (e.g. "2026-08-08")
  date      String
  completed Boolean  @default(true)
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([habitId, date])
  @@index([habitId, date])
}

// ---------------------------------------------------------------------------
// Focus & Deep Work Domain Models
// ---------------------------------------------------------------------------

/// A focused execution block / pomodoro session.
/// Strictly owned by a User; optionally linked to a Project and Task.
model FocusSession {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId         String?
  task           Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  /// "pomodoro" | "short_break" | "long_break" | "custom" | "stopwatch"
  mode           String    @default("pomodoro")
  /// Duration spent, in seconds
  duration       Int
  /// Planned/target duration, in seconds
  targetDuration Int
  completed      Boolean   @default(true)
  notes          String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  /// Soft-delete timestamp. NULL means the record is active.
  deletedAt      DateTime?

  @@index([userId, createdAt])
  @@index([projectId])
  @@index([taskId])
}

// ---------------------------------------------------------------------------
// Notes & Knowledge Hub Domain Models
// ---------------------------------------------------------------------------

/// A lightweight knowledge note linked to productivity workflows.
/// Strictly owned by a User; optionally linked to a Project and Task.
model Note {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId    String?
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  title     String
  content   String    @default("")
  category  String    @default("general")
  color     String    @default("violet")
  pinned    Boolean   @default(false)
  archived  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, updatedAt])
  @@index([projectId])
  @@index([taskId])
}

// ---------------------------------------------------------------------------
// Planning & Time Blocking Domain Models
// ---------------------------------------------------------------------------

/// A planned time block representing WHEN a task/project is scheduled for work.
/// Strictly owned by a User; optionally linked to a Project and Task.
/// A TimeBlock represents PLANNED time; FocusSessions represent ACTUAL execution time.
model TimeBlock {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  title       String
  description String   @default("")

  /// Planned start timestamp
  startTime   DateTime
  /// Planned end timestamp
  endTime     DateTime

  /// One of: planned | in_progress | completed | skipped | cancelled
  status      String   @default("planned")
  /// Accent color key (matches ProjectColor)
  color       String   @default("violet")
  notes       String   @default("")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// Soft-delete timestamp. NULL means the record is active.
  deletedAt   DateTime?

  @@index([userId, startTime])
  @@index([userId, endTime])
  @@index([projectId])
  @@index([taskId])
}

// ---------------------------------------------------------------------------
// Settings & Personalization Domain Model
// ---------------------------------------------------------------------------

/// User-configurable settings and system preferences.
/// Strictly owned by a User with a 1-to-1 relation.
model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // APPEARANCE
  theme         String  @default("system")
  accentColor   String  @default("violet")
  uiDensity     String  @default("comfortable")
  reducedMotion Boolean @default(false)

  // FOCUS
  pomodoroMinutes          Int     @default(25)
  shortBreakMinutes        Int     @default(5)
  longBreakMinutes         Int     @default(15)
  pomodoroCycles           Int     @default(4)
  autoStartBreaks          Boolean @default(false)
  autoStartWork            Boolean @default(false)
  soundEnabled             Boolean @default(true)
  soundVolume              Int     @default(80)
  soundTheme               String  @default("chime")

  // PLANNING
  defaultCalendarView      String  @default("month")
  weekStartsOn             Int     @default(0)
  defaultTimeBlockMinutes  Int     @default(60)
  workdayStart             String  @default("09:00")
  workdayEnd               String  @default("17:00")

  // NOTIFICATIONS
  taskDeadlineReminders        Boolean @default(true)
  timeBlockReminders           Boolean @default(true)
  focusCompletionNotifications Boolean @default(true)
  breakCompletionNotifications Boolean @default(true)
  habitReminders               Boolean @default(true)
  dailyPlanningReminder        Boolean @default(true)

  // OVERLAY PREPARATION (Milestone 14 ready)
  overlayEnabled         Boolean @default(true)
  overlayOpacity         Int     @default(90)
  overlayCompact         Boolean @default(false)
  overlayShowCurrentTask   Boolean @default(true)
  overlayShowTimer         Boolean @default(true)
  overlayShowNextBlock     Boolean @default(true)
  overlayShowProgress      Boolean @default(true)
  overlayShowUrgentTasks   Boolean @default(true)
  overlayUrgentTaskCount   Int     @default(3)
  overlayShowNotifications Boolean @default(true)

  // MILESTONE 18 — PERSONALIZATION & DESKTOP STARTUP
  overlayPreset          String  @default("custom")
  overlayDensity         String  @default("comfortable")
  overlayBlur            Int     @default(20)
  overlayBorder          String  @default("normal")
  overlayTimerSize       String  @default("large")
  overlayTimerGlow       Boolean @default(true)
  overlayTimerWeight     String  @default("bold")
  launchOnStartup        Boolean @default(false)
  launchMinimized        Boolean @default(false)
  startupMode            String  @default("widget")

  // KEYBOARD SHORTCUTS


  customShortcuts Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Notification Model (Milestone 16)
// ---------------------------------------------------------------------------

model Notification {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  title          String
  message        String
  priority       String    @default("normal")
  channel        String    @default("desktop")
  entityId       String?
  entityType     String?
  idempotencyKey String?   @unique
  scheduledFor   DateTime  @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  @@index([userId, scheduledFor])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

